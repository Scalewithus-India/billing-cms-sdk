{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "billing-cms-sdk": ["./src/index.ts"],
      "billing-cms-sdk/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
